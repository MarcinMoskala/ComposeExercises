# Perfetto config used by record-perfetto-trace.sh
# Docs: https://perfetto.dev/docs/concepts/config

buffers {
  size_kb: 131072
  fill_policy: RING_BUFFER
}
buffers {
  size_kb: 4096
  fill_policy: RING_BUFFER
}

# CPU scheduling, frequencies and atrace sections (Choreographer, RenderThread, measure/layout/draw...)
data_sources {
  config {
    name: "linux.ftrace"
    ftrace_config {
      ftrace_events: "sched/sched_switch"
      ftrace_events: "sched/sched_wakeup"
      ftrace_events: "sched/sched_waking"
      ftrace_events: "power/cpu_frequency"
      ftrace_events: "power/suspend_resume"
      atrace_categories: "gfx"
      atrace_categories: "view"
      atrace_categories: "input"
      atrace_categories: "am"
      atrace_categories: "wm"
      atrace_categories: "dalvik"
      atrace_categories: "binder_driver"
      atrace_apps: "com.marcinmoskala.composeexercises"
      buffer_size_kb: 16384
    }
  }
}

# Expected vs actual frame timeline (janky frames are marked in red)
data_sources {
  config {
    name: "android.surfaceflinger.frametimeline"
  }
}

# Process and thread names
data_sources {
  config {
    name: "linux.process_stats"
    target_buffer: 1
    process_stats_config {
      scan_all_processes_on_start: true
    }
  }
}

# Composition tracing: every composable function becomes a slice
data_sources {
  config {
    name: "track_event"
    track_event_config {
      enabled_categories: "*"
    }
  }
}

duration_ms: 10000
